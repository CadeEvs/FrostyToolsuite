<ctrl:FrostyDockableWindow x:Class="FrostyEditor.Windows.ModSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FrostyEditor.Windows"
        xmlns:ctrl="clr-namespace:Frosty.Controls;assembly=FrostyControls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:ModSettingsWindow}"
        Title="Export Mod" MinHeight="530" Height="530" MinWidth="600" Width="600"
        WindowStartupLocation="CenterScreen" SnapsToDevicePixels="True">
    
    <Window.Resources>
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBoxBase}}">
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)/ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <Grid Background="{StaticResource ListBackground}">
            <DockPanel LastChildFill="True">
                <TextBlock Margin="5,8" DockPanel.Dock="Top"
                           Text="Please fill out each of the following sections. Only the first 4 fields are mandatory."
                           FontWeight="Bold" FontSize="14"
                           TextWrapping="WrapWithOverflow" TextAlignment="Center"
                           Foreground="{StaticResource FontColor}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                
                <Border DockPanel.Dock="Top" Background="{StaticResource ControlBackground}" Height="2" HorizontalAlignment="Stretch"/>
                
                <Grid DockPanel.Dock="Top" Margin="5">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Label Content="Title" Width="75"/>
                            <TextBox x:Name="modTitleTextBox" VerticalContentAlignment="Center" Margin="1" BorderThickness="1"
                                     Text="{Binding ModTitle, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <DockPanel LastChildFill="True">
                            <Label Content="Author" Width="75"/>
                            <TextBox x:Name="modAuthorTextBox" VerticalContentAlignment="Center" Margin="1" BorderThickness="1"
                                     Text="{Binding ModAuthor, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <DockPanel LastChildFill="True">
                            <Label Content="Version" Width="75"/>
                            <TextBox x:Name="modVersionTextBox" VerticalContentAlignment="Center" Margin="1" BorderThickness="1"
                                     Text="{Binding ModVersion, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <DockPanel LastChildFill="True">
                            <Label Content="Category" Width="75"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0" x:Name="modCategoryComboBox" Margin="1,1,0,1"
                                          ItemsSource="{Binding Categories}" SelectedIndex="{Binding SelectedCategoryIndex}"/>
                                <TextBox Grid.Column="1" x:Name="modCategoryTextBox" VerticalContentAlignment="Center" Margin="1" BorderThickness="1"
                                         Text="{Binding ModCategory, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCustomCategory}"/>
                            </Grid>
                        </DockPanel>
                        <DockPanel LastChildFill="True">
                            <Label Content="Link" Width="75"/>
                            <TextBox x:Name="modPageLinkTextBox" VerticalContentAlignment="Center"
                                     Text="{Binding ModLink, UpdateSourceTrigger=PropertyChanged}" Margin="1" BorderThickness="1"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>
                
                <Grid DockPanel.Dock="Top" Margin="5">
                    <ctrl:FrostyImageButton x:Name="iconImageButton" HorizontalAlignment="Left" Title="ICON" OnValidate="FrostyImageButton_OnValidate" Margin="16,0,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,16,0">
                        <ctrl:FrostyImageButton x:Name="ssImageButton1" Title="IMAGE" OnValidate="FrostyImageButton_OnValidate" Margin="0,0,4,0"/>
                        <ctrl:FrostyImageButton x:Name="ssImageButton2" Title="IMAGE" OnValidate="FrostyImageButton_OnValidate" Margin="0,0,4,0"/>
                        <ctrl:FrostyImageButton x:Name="ssImageButton3" Title="IMAGE" OnValidate="FrostyImageButton_OnValidate" Margin="0,0,4,0"/>
                        <ctrl:FrostyImageButton x:Name="ssImageButton4" Title="IMAGE" OnValidate="FrostyImageButton_OnValidate" Margin="0"/>
                    </StackPanel>
                </Grid>
                
                <TextBox x:Name="modDescriptionTextBox"
                         Margin="5" BorderThickness="1"
                         AcceptsReturn="True" AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         Text="{Binding ModDescription, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
        </Grid>

        <Border Grid.Row="1">
            <Grid Margin="8">
                <DockPanel LastChildFill="True">
                    <Button x:Name="cancelButton" Content="Cancel" DockPanel.Dock="Left" Width="75" Click="cancelButton_Click"/>
                    <Button x:Name="saveButton" Content="Save" DockPanel.Dock="Right" Width="75" Click="saveButton_Click"/>
                    <TextBlock Text="{Binding PrimaryError}"
                               ToolTip="{Binding ErrorSummary}"
                               Foreground="Red"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="2,0"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasErrors}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</ctrl:FrostyDockableWindow>
